# ----- Private / sensitive files -----
# Database credentials, API keys, environment config
/app/config/parameters.php
/app/config/parameters.yml
config/settings.inc.php
.env.local
.env.*.local

# ----- Cache, logs and temp files -----
/var/cache/
/var/logs/
/var/log/
/cache/
*.log

# ----- Vendor / dependencies (installed via Composer) -----
/vendor/
/modules/*/vendor/

# ----- Node / front-end build dependencies -----
/node_modules/
/themes/*/node_modules/
/adm/themes/new-theme/node_modules/

# ----- Compiled / generated assets -----
/themes/*/assets/css/
/themes/*/assets/js/
/admin-dev/themes/new-theme/public/

# ----- Admin auto-upgrade -----
/adm/autoupgrade/

# ----- Backups, exports, imports -----
/adm/backups/
/adm/export/
/adm/import/

# ----- Upload & download directories -----
/upload/
/download/*
!/download/index.php
!/download/.htaccess

# ----- User-uploaded images & media -----
/img/p/
/img/c/
/img/m/
/img/su/
/img/st/
/img/co/
/img/s/
/img/scenes/
/img/tmp/
/img/cms/

# ----- Translations generated by PrestaShop -----
/translations/*
!/translations/index.php
/app/Resources/translations/*

# Module-generated translations
/modules/*/translations/*
/themes/*/modules/*/translations/*

# ----- Sitemaps -----
*sitemap*.xml

# ----- Robots.txt (uncomment if you don't want to version it) -----
# /robots.txt

# ----- Theme cache -----
/themes/*/cache/

# ----- htaccess (often server-specific; uncomment to ignore) -----
# /.htaccess

# ----- IDE / editor files -----
/.idea/
/.vscode/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace
nbproject/

# ----- OS files -----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- Docker (if applicable) -----
/docker-compose.override.yml
/.docker/

# ----- PHPUnit / testing -----
/tests/coverage/
.phpunit.result.cache
.php-cs-fixer.cache

# ----- Composer artifacts -----
composer.phar